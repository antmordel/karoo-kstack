<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/field_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/setting_secondary_layout"
        android:textSize="13sp" />

    <RadioGroup
        android:id="@+id/layout_choice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/layout_side_by_side"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/toggle_button_bg"
            android:button="@null"
            android:gravity="center"
            android:minHeight="38dp"
            android:paddingVertical="8dp"
            android:text="@string/setting_layout_side_by_side"
            android:textAlignment="center"
            android:textColor="@color/toggle_button_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/layout_stacked"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/toggle_button_bg"
            android:button="@null"
            android:gravity="center"
            android:minHeight="38dp"
            android:paddingVertical="8dp"
            android:text="@string/setting_layout_stacked"
            android:textAlignment="center"
            android:textColor="@color/toggle_button_text"
            android:textSize="12sp"
            android:textStyle="bold" />
    </RadioGroup>

    <!-- Hidden for a metric the rider has no zones for; MainActivity decides from the definition. -->
    <LinearLayout
        android:id="@+id/zone_color_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_zone_color"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/zone_color_choice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/zone_color_none"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/toggle_button_bg"
                android:button="@null"
                android:gravity="center"
                android:minHeight="38dp"
                android:paddingVertical="8dp"
                android:text="@string/setting_zone_color_none"
                android:textAlignment="center"
                android:textColor="@color/toggle_button_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/zone_color_icon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/toggle_button_bg"
                android:button="@null"
                android:gravity="center"
                android:minHeight="38dp"
                android:paddingVertical="8dp"
                android:text="@string/setting_zone_color_icon"
                android:textAlignment="center"
                android:textColor="@color/toggle_button_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/zone_color_field"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/toggle_button_bg"
                android:button="@null"
                android:gravity="center"
                android:minHeight="38dp"
                android:paddingVertical="8dp"
                android:text="@string/setting_zone_color_field"
                android:textAlignment="center"
                android:textColor="@color/toggle_button_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/setting_zone_palette"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/zone_palette_choice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/palette_karoo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/toggle_button_bg"
                android:button="@null"
                android:gravity="center"
                android:minHeight="38dp"
                android:paddingVertical="8dp"
                android:text="@string/setting_palette_karoo"
                android:textAlignment="center"
                android:textColor="@color/toggle_button_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/palette_garmin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/toggle_button_bg"
                android:button="@null"
                android:gravity="center"
                android:minHeight="38dp"
                android:paddingVertical="8dp"
                android:text="@string/setting_palette_garmin"
                android:textAlignment="center"
                android:textColor="@color/toggle_button_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/palette_zwift"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/toggle_button_bg"
                android:button="@null"
                android:gravity="center"
                android:minHeight="38dp"
                android:paddingVertical="8dp"
                android:text="@string/setting_palette_zwift"
                android:textAlignment="center"
                android:textColor="@color/toggle_button_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </RadioGroup>
    </LinearLayout>

    <!-- Shown only for Power stack; MainActivity decides from definition.fieldId -->
    <LinearLayout
        android:id="@+id/power_averaging_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_power_averaging"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/power_averaging_choice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/power_avg_instant"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/toggle_button_bg"
                android:button="@null"
                android:gravity="center"
                android:minHeight="38dp"
                android:paddingVertical="8dp"
                android:text="@string/power_averaging_instant"
                android:textAlignment="center"
                android:textColor="@color/toggle_button_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/power_avg_3s"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/toggle_button_bg"
                android:button="@null"
                android:gravity="center"
                android:minHeight="38dp"
                android:paddingVertical="8dp"
                android:text="@string/power_averaging_3s"
                android:textAlignment="center"
                android:textColor="@color/toggle_button_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/power_avg_5s"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/toggle_button_bg"
                android:button="@null"
                android:gravity="center"
                android:minHeight="38dp"
                android:paddingVertical="8dp"
                android:text="@string/power_averaging_5s"
                android:textAlignment="center"
                android:textColor="@color/toggle_button_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/power_avg_10s"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/toggle_button_bg"
                android:button="@null"
                android:gravity="center"
                android:minHeight="38dp"
                android:paddingVertical="8dp"
                android:text="@string/power_averaging_10s"
                android:textAlignment="center"
                android:textColor="@color/toggle_button_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/power_avg_30s"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/toggle_button_bg"
                android:button="@null"
                android:gravity="center"
                android:minHeight="38dp"
                android:paddingVertical="8dp"
                android:text="@string/power_averaging_30s"
                android:textAlignment="center"
                android:textColor="@color/toggle_button_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </RadioGroup>
    </LinearLayout>
</LinearLayout>
